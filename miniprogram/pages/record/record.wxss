.container {
  padding: 30rpx;
}

.form-section {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.model-selector {
  display: flex;
  gap: 16rpx;
}

.model-option {
  flex: 1;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  transition: all 0.2s;
}

.model-option.active {
  border-color: #07c160;
  background: #f0fdf4;
}

.model-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.model-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.model-option.active .model-name {
  color: #07c160;
}

.commission-hint {
  background: #fef3c7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  font-size: 26rpx;
  color: #92400e;
  text-align: center;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160 !important;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  opacity: 0.6;
}
