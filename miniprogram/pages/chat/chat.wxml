<view class="container">
  <!-- 角色标识 -->
  <view class="chat-header">
    <text class="role-badge {{userRole}}">{{roleName}}</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="msg-list" scroll-y scroll-with-animation upper-threshold="50">
    <view wx:for="{{messages}}" wx:for-index="idx" wx:key="idx" class="msg-item {{item.role === 'user' ? 'right' : 'left'}}">
      <view class="msg-bubble {{item.role}}">
        <text class="msg-text">{{item.text}}</text>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>
    <view id="msg-end"></view>
  </scroll-view>

  <!-- 快捷功能 -->
  <view wx:if="{{!sending && suggestions.length > 0}}" class="suggestions">
    <view
      class="suggestion-item"
      wx:for="{{suggestions}}"
      wx:for-index="idx"
      wx:key="idx"
      data-text="{{item.text}}"
      bindtap="onSuggestion"
    >
      <text>{{item.icon}} {{item.text}}</text>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input
      class="input-field"
      type="text"
      placeholder="点这里说话或打字记账..."
      value="{{input}}"
      bindinput="onInput"
      bindconfirm="onConfirm"
      disabled="{{sending}}"
    />
    <button
      class="send-btn {{canSend ? 'active' : ''}}"
      size="mini"
      bind:tap="handleSend"
      disabled="{{!canSend || sending}}"
    >{{sending ? '...' : '发送'}}</button>
  </view>
</view>
