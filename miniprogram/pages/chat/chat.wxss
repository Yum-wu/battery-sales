.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 聊天头部角色标识 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.role-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.role-badge.boss {
  background: #fff3e0;
  color: #e65100;
}

.role-badge.salesperson {
  background: #e3f2fd;
  color: #1565c0;
}

.msg-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 20rpx;
}

.msg-item {
  margin-bottom: 24rpx;
  display: flex;
}

.msg-item.right {
  justify-content: flex-end;
}

.msg-item.left {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  position: relative;
}

.msg-bubble.user {
  background: #07c160;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-bubble.assistant {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.msg-text {
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.msg-time {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
  text-align: right;
}

.msg-bubble.assistant .msg-time {
  color: #bbb;
}

/* ====== 表格样式 ====== */

.table-wrap {
  margin-top: 16rpx;
  border-top: 1rpx solid #eee;
  padding-top: 12rpx;
}

.table-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
  text-align: center;
}

.table-grid {
  display: table;
  width: 100%;
  border-collapse: collapse;
  font-size: 24rpx;
}

.table-row {
  display: table-row;
}

.table-cell {
  display: table-cell;
  padding: 10rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
  color: #555;
  vertical-align: middle;
}

.table-row.header .table-cell {
  font-weight: 700;
  color: #333;
  background: #f9fafb;
  border-bottom: 2rpx solid #e5e7eb;
}

.table-row.footer .table-cell {
  font-weight: 700;
  color: #07c160;
  border-top: 2rpx solid #e5e7eb;
  border-bottom: none;
  background: #f0fdf4;
}

/* 用户消息里的表格 */
.msg-bubble.user .table-wrap {
  border-top-color: rgba(255,255,255,0.2);
}

.msg-bubble.user .table-title {
  color: #fff;
}

.msg-bubble.user .table-cell {
  color: rgba(255,255,255,0.9);
  border-bottom-color: rgba(255,255,255,0.15);
}

.msg-bubble.user .table-row.header .table-cell {
  color: #fff;
  background: rgba(255,255,255,0.12);
  border-bottom-color: rgba(255,255,255,0.3);
}

.msg-bubble.user .table-row.footer .table-cell {
  color: #fff;
  background: rgba(255,255,255,0.1);
  border-top-color: rgba(255,255,255,0.3);
}

/* ====== 输入栏 ====== */

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
}

.input-field {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
}

.input-field::placeholder {
  color: #bbb;
}

.send-btn {
  margin-left: 16rpx;
  flex-shrink: 0;
  background: #ccc !important;
  color: #fff !important;
  border-radius: 40rpx;
  padding: 0 36rpx;
  line-height: 80rpx;
  height: 80rpx;
  font-size: 30rpx;
  border: none;
  font-weight: 600;
}

.send-btn.active {
  background: #07c160 !important;
}

.send-btn[disabled] {
  opacity: 0.5;
}

/* ====== 快捷功能 ====== */

.suggestions {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 20rpx 4rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  gap: 12rpx;
}

.suggestion-item {
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  border: 1rpx solid #e8e8e8;
}

.suggestion-item:active {
  background: #e8e8e8;
}

/* ====== 语音提示 ====== */
.voice-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  padding: 8rpx 0;
  background: #f5f5f5;
}
