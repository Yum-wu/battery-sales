.container {
  padding: 30rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.commission {
  color: #f59e0b;
  font-weight: 600;
}

.model-A { color: #07c160; font-weight: 600; }
.model-B { color: #3b82f6; font-weight: 600; }
.model-C { color: #d97706; font-weight: 600; }

.source-api { color: #666; }
.source-wechat { color: #07c160; }

.edit-input {
  width: 240rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  text-align: right;
}

.actions {
  margin-top: 40rpx;
}

.action-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.edit {
  background: #3b82f6;
  color: #fff;
}

.action-btn.save {
  background: #07c160;
  color: #fff;
}

.action-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.action-btn.delete {
  background: #fee2e2;
  color: #e53e3e;
}
