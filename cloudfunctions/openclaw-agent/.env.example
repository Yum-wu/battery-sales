# CloudBase Environment Configuration
CLOUDBASE_ENV_ID=hermes-d7gvpvoah15874de5
CLOUDBASE_SECRET_ID=your_secret_id_here
CLOUDBASE_SECRET_KEY=your_secret_key_here

# AI Model Configuration (Using WeChat Developer's 100M tokens)
# Recommended models:
# - hunyuan-2.0-instruct-20251111 (Hunyuan)
# - deepseek-v3.2 (DeepSeek)
AI_MODEL_PROVIDER=hunyuan-exp
AI_MODEL_NAME=hunyuan-2.0-instruct-20251111

# WeChat Mini Program credentials (for jscode2session login)
# 在微信公众平台 -> 开发 -> 开发设置 获取
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret

# Server Configuration
PORT=9000
NODE_ENV=production