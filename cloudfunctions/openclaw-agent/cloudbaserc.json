{
  "envId": "hermes-d7gvpvoah15874de5",
  "version": "2.0",
  "functionRoot": "./",
  "functions": [
    {
      "name": "openclaw-agent",
      "timeout": 900,
      "envVariables": {
        "WECHAT_APPID": "你的小程序AppID",
        "WECHAT_SECRET": "你的小程序AppSecret"
      },
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "ignore": [
        "node_modules",
        "node_modules/**/*",
        ".env",
        ".git",
        ".gitignore",
        "README.md",
        "cloudbaserc.json"
      ]
    }
  ],
  "cloudrun": [
    {
      "name": "openclaw-agent",
      "cpu": 0.25,
      "mem": 0.5,
      "minNum": 1,
      "maxNum": 10,
      "containerPort": 9000,
      "dockerfilePath": "./Dockerfile",
      "buildDir": "./",
      "envVariables": {}
    }
  ]
}